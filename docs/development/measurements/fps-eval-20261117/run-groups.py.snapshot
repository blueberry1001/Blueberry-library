import subprocess,json,statistics,hashlib,platform
from pathlib import Path
base=Path('.build/fps-eval-study');exe=str(base/'eval.exe')
r={'cases':[],'warmups':1,'runs':7,'compiler':'Unity NDK clang 18.0.3, Windows MSVC ABI','flags':'-O2 -DNDEBUG -std=gnu++20','platform':platform.platform(),'processor':platform.processor(),'source_sha256':hashlib.sha256((base/'eval.cpp').read_bytes()).hexdigest(),'note':'same vector and x values; full baseline/horner/group loop; preparation excluded'}
for n,q in [(0,1000000),(1,1000000),(16,200000),(31,100000),(32,100000),(33,100000),(256,20000),(4097,1250),(65536,100)]:
 rows=[]
 for i in range(8):
  modes=[0,1,2,3];modes=modes[i%4:]+modes[:i%4]
  for v in modes:
   p=subprocess.run([exe,str(n),str(q),str(v)],capture_output=True,text=True,check=True); fields=p.stdout.split();rows.append({'run':i,'mode':v,'checksum':fields[0],'ms':float(fields[1])})
 assert len({x['checksum'] for x in rows})==1
 c={'n':n,'q':q,'samples':rows,'median':[statistics.median(x['ms'] for x in rows if x['run'] and x['mode']==v) for v in range(4)]};r['cases'].append(c);print(n,c['median'],flush=True)
(base/'results-grouped.json').write_text(json.dumps(r,indent=2)+'\n')
