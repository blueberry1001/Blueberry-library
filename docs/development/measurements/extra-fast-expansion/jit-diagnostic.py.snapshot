#!/usr/bin/env python3
"""Functional diagnosis only: GCC default CET versus explicit CET disabled."""
import hashlib,json,os,platform,re,subprocess,tempfile
from pathlib import Path
HERE=Path(__file__).resolve().parent;ROOT=HERE.parents[3]
out=HERE/'jit-diagnostic'
if out.exists() and any(out.iterdir()):raise SystemExit('nonempty output')
out.mkdir(exist_ok=True)
flags=['-std=gnu++23','-O2','-DNDEBUG','-march=native','-fno-diagnostics-show-caret']
sources=[ROOT/f'.benchmark/extra-fast/bitset-research/submission-{n}.cpp'for n in[246187,406212]]
sha=lambda b:hashlib.sha256(b).hexdigest()
data={'purpose':'Functional-only diagnosis while unrelated validation may run; no timing claims. Original benchmark results/failures are immutable.','platform':platform.platform(),'compiler':subprocess.check_output(['g++','--version'],text=True),'input':'1 1 1\n1\n1\n','expected':'1\n','source_sha256':{str(p):sha(p.read_bytes())for p in sources},'profiles':{'original-cli':flags,'cet-disabled':flags+['-fcf-protection=none','-fno-stack-protector']},'results':[]}
with tempfile.TemporaryDirectory(prefix='extra-fast-jit-diagnostic-')as tmp:
 d=Path(tmp);fixture=d/'input';fixture.write_text(data['input'])
 for source in sources:
  for profile,options in data['profiles'].items():
   binary=d/(source.stem+'-'+profile);cmd=['g++',*options,str(source),'-o',str(binary)];r=subprocess.run(cmd,capture_output=True,text=True)
   (out/(source.stem+'-'+profile+'.log')).write_text(json.dumps(cmd)+'\n'+r.stdout+r.stderr)
   row={'submission':source.stem,'profile':profile,'compile_returncode':r.returncode}
   if not r.returncode:
    disasm=subprocess.check_output(['objdump','-d','-C',str(binary)],text=True)
    row['kernel_first_instruction']={}
    for kernel in ['kernel_1','kernel_2','kernel_3']:
     found=re.search(r'^([0-9a-f]+) <'+kernel+r'\(\)>:\n([^\n]+)',disasm,re.M)
     if found:row['kernel_first_instruction'][kernel]=found.group(2).strip()
    dest=d/'output'
    with fixture.open('rb')as f,dest.open('wb')as g:r=subprocess.run([str(binary)],stdin=f,stdout=g,stderr=subprocess.PIPE,timeout=30)
    row.update(returncode=r.returncode,output_sha256=sha(dest.read_bytes()),correct=r.returncode==0 and dest.read_text()==data['expected'],stderr=r.stderr.decode(errors='replace'))
   data['results'].append(row)
(out/'diagnostic.json').write_text(json.dumps(data,indent=2)+'\n')
print(json.dumps(data['results'],indent=2))
