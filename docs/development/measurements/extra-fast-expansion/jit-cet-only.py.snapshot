#!/usr/bin/env python3
"""One functional-only run isolates CET; no stack-protector override."""
import hashlib,json,platform,subprocess,tempfile
from pathlib import Path
HERE=Path(__file__).resolve().parent;ROOT=HERE.parents[3];out=HERE/'jit-cet-only-diagnostic'
if out.exists() and any(out.iterdir()):raise SystemExit('nonempty output')
out.mkdir(exist_ok=True)
source=ROOT/'.benchmark/extra-fast/bitset-research/submission-246187.cpp'
with tempfile.TemporaryDirectory(prefix='extra-fast-cet-only-')as tmp:
 d=Path(tmp);binary=d/'program';cmd=['g++','-std=gnu++23','-O2','-DNDEBUG','-march=native','-fno-diagnostics-show-caret','-fcf-protection=none',str(source),'-o',str(binary)]
 r=subprocess.run(cmd,capture_output=True,text=True);(out/'compile.log').write_text(json.dumps(cmd)+'\n'+r.stdout+r.stderr)
 row={'purpose':'Functional-only CET isolation while validation runs; no performance measurement','source_sha256':hashlib.sha256(source.read_bytes()).hexdigest(),'compiler':subprocess.check_output(['g++','--version'],text=True),'platform':platform.platform(),'command':cmd,'compile_returncode':r.returncode,'input':'1 1 1\n1\n1\n','expected':'1\n','stack_protector':'unchanged compiler default'}
 if not r.returncode:
  f=d/'input';g=d/'output';f.write_text(row['input'])
  with f.open('rb')as inp,g.open('wb')as dest:r=subprocess.run([str(binary)],stdin=inp,stdout=dest,stderr=subprocess.PIPE,timeout=30)
  row.update(returncode=r.returncode,output_sha256=hashlib.sha256(g.read_bytes()).hexdigest(),correct=r.returncode==0 and g.read_text()==row['expected'],stderr=r.stderr.decode(errors='replace'))
 (out/'diagnostic.json').write_text(json.dumps(row,indent=2)+'\n');print(json.dumps(row,indent=2))
