from pathlib import Path
import datetime, hashlib, json, shutil, subprocess, sys, time

root = Path.cwd()
out = root/'docs/development/measurements/extra-fast-more/sets/validation'
out.mkdir(parents=True,exist_ok=False)
temporary = Path('/tmp/blueberry-extra-fast-sets-20261020/validation')
temporary.mkdir(parents=True,exist_ok=True)
sources = [root/'blueberry/extra-fast/ordered-map.hpp', root/'blueberry/extra-fast/hash-map.hpp', root/'tests/random/extra-fast-associative.cpp']
for p in sources: shutil.copyfile(p,out/(p.name+'.snapshot'))
shutil.copyfile(Path(__file__),out/'runner.py.snapshot')
(out/'environment.json').write_text(json.dumps({'started':datetime.datetime.now(datetime.timezone.utc).isoformat(),'sha256':{str(p.relative_to(root)):hashlib.sha256(p.read_bytes()).hexdigest() for p in sources},'seed':20261020},indent=2)+'\n')
commands=[]
def run(command, input=None):
    start=time.monotonic();r=subprocess.run(command,input=input,capture_output=True,text=True,timeout=180)
    row={'command':command,'code':r.returncode,'seconds':time.monotonic()-start,'stdout':r.stdout,'stderr':r.stderr}
    commands.append(row);(out/'commands.json').write_text(json.dumps(commands,indent=2)+'\n')
    print(command[0],command[-1],r.returncode,flush=True)
    return r.returncode==0

for compiler in ['g++','clang++']:
    for standard in ['gnu++20','gnu++23']:
        for backend,flags in [('intrinsic',[]),('scalar',['-DBLUEBERRY_EXTRA_FAST_FORCE_SCALAR']),('asm',['-DBLUEBERRY_EXTRA_FAST_USE_ASM']),('intel',['-DBLUEBERRY_EXTRA_FAST_USE_ASM','-masm=intel'])]:
            binary=temporary/f'{compiler}-{standard}-{backend}'
            command=[compiler,f'-std={standard}','-O2','-Wall','-Wextra','-Wshadow','-Werror','-I.',*flags,'tests/random/extra-fast-associative.cpp','-o',str(binary)]
            if run(command):
                for seed in ['20261020','1','987654321']: run([str(binary),seed])
        for header in ['ordered-map','hash-map']:
            run([compiler,f'-std={standard}','-O2','-DNDEBUG','-Wall','-Wextra','-Wshadow','-Werror','-I.','-x','c++','-fsyntax-only','-'],f'#include "blueberry/extra-fast/{header}.hpp"\n#include "blueberry/extra-fast/{header}.hpp"\nint main() {{}}\n')
        for name in ['ordered-map','hash-map','ordered-set']:
            run([compiler,f'-std={standard}','-O2','-Wall','-Wextra','-Wshadow','-Werror','-I.',f'verify/extra-fast/{name}.test.cpp','-o',str(temporary/f'{compiler}-{standard}-{name}')])
    binary=temporary/f'{compiler}-sanitize'
    if run([compiler,'-std=gnu++23','-O1','-g','-fsanitize=address,undefined','-fno-omit-frame-pointer','-I.','tests/random/extra-fast-associative.cpp','-o',str(binary)]):
        run([str(binary),'20261020'])
failed=[r for r in commands if r['code']]
print(json.dumps({'commands':len(commands),'failed':len(failed)}),flush=True)
sys.exit(bool(failed))
