from pathlib import Path
import hashlib, json, shutil, subprocess, sys, time
root=Path.cwd()
out=root/'docs/development/measurements/extra-fast-more/sets/optional-return-fix'
mode=sys.argv[1]
out.mkdir(parents=True,exist_ok=True)
header=root/'blueberry/extra-fast/ordered-map.hpp'
source=root/'.benchmark/extra-fast-more/optional-return.cpp'
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
shutil.copyfile(header,out/(mode+'.hpp.snapshot'))
shutil.copyfile(source,out/'reproducer.cpp.snapshot')
shutil.copyfile(Path(__file__),out/'runner.py.snapshot')
rows=[]
for compiler in ['g++','clang++']:
    binary=f'/tmp/blueberry-optional-{compiler}-{mode}'
    command=[compiler,'-std=gnu++20','-O2','-Wall','-Wextra','-Wshadow','-Werror','-I.',str(source),'-o',binary]
    result=subprocess.run(command,text=True,capture_output=True)
    row={'compiler':compiler,'command':command,'compile_code':result.returncode,'stdout':result.stdout,'stderr':result.stderr}
    if result.returncode==0:
        result=subprocess.run([binary],text=True,capture_output=True)
        row.update(run_code=result.returncode,run_stdout=result.stdout,run_stderr=result.stderr)
    rows.append(row)
    print(compiler,mode,row,flush=True)
(out/(mode+'.json')).write_text(json.dumps(rows,indent=2)+'\n')
if mode=='before':
    assert all(r['compile_code']==0 and r.get('run_code')==1 for r in rows)
else:
    assert all(r['compile_code']==0 and r.get('run_code')==0 for r in rows)
    builds=json.loads((out.parent/'final/builds.json').read_text())
    equivalence=[]
    for i,build in enumerate(builds):
        command=list(build['command']);at=command.index('-o')+1;old=command[at]
        new=f'/tmp/blueberry-optional-final-equivalence-{i}'
        command[at]=new
        result=subprocess.run(command,text=True,capture_output=True)
        row={'compiler':build['compiler'],'profile':build['profile'],'bits':build['bits'],'command':command,'code':result.returncode,'stdout':result.stdout,'stderr':result.stderr,'old_sha256':sha(old)}
        if not result.returncode:row.update(new_sha256=sha(new),identical=sha(old)==sha(new))
        equivalence.append(row)
        (out/'binary-equivalence.json').write_text(json.dumps(equivalence,indent=2)+'\n')
        print('equivalence',i,row.get('identical'),flush=True)
    assert all(r.get('identical') for r in equivalence)
print('ok',mode,sha(header),flush=True)
