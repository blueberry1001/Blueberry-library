#pragma once
#include <algorithm>
#include <array>
#include <bit>
#include <cassert>
#include <cstddef>
#include <cstdint>
#include <iterator>
#include <limits>
#include <memory>
#include <optional>
#include <type_traits>
#include <utility>
#include <vector>
#if (defined(__x86_64__) || defined(__i386__)) && (defined(__GNUC__) || defined(__clang__))
#include <immintrin.h>
#define BLUEBERRY_ORDERED_AVX 1
#else
#define BLUEBERRY_ORDERED_AVX 0
#endif
namespace blueberry::extra_fast {
namespace internal {
struct OrderedSetMarker { std::uint8_t unused; };
}
// Dynamic integer B+ tree; node search uses AVX2 when available.
// Full 32/64-bit keys, trivial values. Mutations invalidate iterators/references.
template <class Key = std::uint32_t, class Value = std::uint64_t>
class OrderedMap {
  static_assert(std::is_integral_v<Key> && (sizeof(Key) == 4 || sizeof(Key) == 8));
  static_assert(std::is_trivial_v<Value> && std::is_trivially_copy_constructible_v<Value> &&
                std::is_trivially_copy_assignable_v<Value>);
  static constexpr int B = 16, C = B + 1;
  static constexpr bool is_set_ = std::is_same_v<Value, internal::OrderedSetMarker>;
  using Entry = std::conditional_t<is_set_, Value, std::pair<const Key, Value>>;
  struct alignas(64) Node {
    std::array<Key, 24> key{};
    union Data {
      std::array<Entry, C> value;
      std::array<int, C> child;
      Data() {}
      ~Data() {}
    } data;
    int n = 0, total = 0;
    int prev = -1, next = -1;
    bool leaf = true;
    explicit Node(bool is_leaf = true) : leaf(is_leaf) {
      if (leaf)
        std::construct_at(&data.value);
      else
        std::construct_at(&data.child);
    }
    Node(const Node& other) noexcept
        : key(other.key), n(other.n), total(other.total), prev(other.prev),
          next(other.next), leaf(other.leaf) {
      if (leaf) std::construct_at(&data.value, other.data.value);
      else std::construct_at(&data.child, other.data.child);
    }
    Node(Node&& other) noexcept : Node(std::as_const(other)) {}
    ~Node() {
      if (leaf) std::destroy_at(&data.value);
      else std::destroy_at(&data.child);
    }
  };
  struct Path {
    std::array<int, 32> node, child;
    int depth = 0, leaf = -1, pos = 0, rank = 0;
  };
  std::vector<Node> nodes_;
  int root_ = -1, free_ = -1, first_ = -1, last_ = -1;
  bool simd_ = false;
  Value& value(int id, int at) {
    if constexpr (is_set_) return nodes_[id].data.value[at];
    else return nodes_[id].data.value[at].second;
  }
  const Value& value(int id, int at) const {
    if constexpr (is_set_) return nodes_[id].data.value[at];
    else return nodes_[id].data.value[at].second;
  }
  void entry(int id, int at, Key key, const Value& v) {
    if constexpr (is_set_) nodes_[id].data.value[at] = v;
    else {
      auto* p = &nodes_[id].data.value[at];
      std::destroy_at(p);
      std::construct_at(p, key, v);
    }
  }
  int allocate(bool leaf) {
    if (free_ != -1) {
      int id = free_;
      free_ = nodes_[id].data.child[0];
      std::destroy_at(&nodes_[id]);
      std::construct_at(&nodes_[id], leaf);
      return id;
    }
    nodes_.emplace_back(leaf);
    return static_cast<int>(nodes_.size()) - 1;
  }
  void recycle(int id) {
    std::destroy_at(&nodes_[id]);
    std::construct_at(&nodes_[id], false);
    nodes_[id].data.child[0] = free_;
    free_ = id;
  }
  void pull(int id) {
    auto& n = nodes_[id];
    if (n.leaf) {
      n.total = n.n;
      return;
    }
    n.total = 0;
    for (int i = 0; i < n.n; ++i) {
      const auto& c = nodes_[n.data.child[i]];
      n.key[i] = c.key[c.n - 1];
      n.total += c.total;
    }
  }
  static int lower_scalar(const Node& n, Key key) {
    return static_cast<int>(std::lower_bound(n.key.begin(), n.key.begin() + n.n, key) -
                            n.key.begin());
  }
#if BLUEBERRY_ORDERED_AVX
  __attribute__((target("avx2"))) static int lower_simd(const Node& n, Key key) {
    const auto sign =
        std::is_unsigned_v<Key> ? (std::make_unsigned_t<Key>(1) << (sizeof(Key) * 8 - 1)) : 0;
    std::uint64_t mask = 0;
    if constexpr (sizeof(Key) == 4) {
      auto x = _mm256_set1_epi32(static_cast<std::int32_t>(std::make_unsigned_t<Key>(key) ^ sign));
      auto flip = _mm256_set1_epi32(static_cast<std::int32_t>(sign));
      for (int i = 0; i < n.n; i += 8) {
        auto v = _mm256_xor_si256(
            _mm256_loadu_si256(reinterpret_cast<const __m256i*>(n.key.data() + i)), flip);
        __m256i cmp;
#ifdef BLUEBERRY_EXTRA_FAST_USE_ASM
        asm("vpcmpgtd {%2,%1,%0|%0,%1,%2}" : "=x"(cmp) : "x"(x), "x"(v));
#else
        cmp = _mm256_cmpgt_epi32(x, v);
#endif
        mask |= static_cast<std::uint64_t>(_mm256_movemask_ps(_mm256_castsi256_ps(cmp))) << i;
      }
    } else {
      auto x = _mm256_set1_epi64x(static_cast<std::int64_t>(std::make_unsigned_t<Key>(key) ^ sign));
      auto flip = _mm256_set1_epi64x(static_cast<std::int64_t>(sign));
      for (int i = 0; i < n.n; i += 4) {
        auto v = _mm256_xor_si256(
            _mm256_loadu_si256(reinterpret_cast<const __m256i*>(n.key.data() + i)), flip);
        __m256i cmp;
#ifdef BLUEBERRY_EXTRA_FAST_USE_ASM
        asm("vpcmpgtq {%2,%1,%0|%0,%1,%2}" : "=x"(cmp) : "x"(x), "x"(v));
#else
        cmp = _mm256_cmpgt_epi64(x, v);
#endif
        mask |= static_cast<std::uint64_t>(_mm256_movemask_pd(_mm256_castsi256_pd(cmp))) << i;
      }
    }
    return std::countr_zero((~mask & ((1ull << n.n) - 1)) | (1ull << n.n));
  }
#endif
  int lower(const Node& n, Key key) const {
#if BLUEBERRY_ORDERED_AVX
    if (simd_)
      return lower_simd(n, key);
#endif
    return lower_scalar(n, key);
  }
  template <bool NeedRank = false>
  Path seek(Key key) const {
    Path p;
    int id = root_;
    while (id != -1) {
      const auto& n = nodes_[id];
      int at = lower(n, key);
      if (n.leaf) {
        p.leaf = id;
        p.pos = at;
        return p;
      }
      at = std::min(at, n.n - 1);
      p.node[p.depth] = id;
      p.child[p.depth++] = at;
      if constexpr (NeedRank)
        for (int i = 0; i < at; ++i)
          p.rank += nodes_[n.data.child[i]].total;
      id = n.data.child[at];
    }
    return p;
  }
  std::optional<std::pair<Key, Value>> bound(Key key, int direction) const {
    auto p = seek(key);
    if (p.leaf == -1)
      return {};
    int id = p.leaf, at = p.pos;
    if (direction > 0 && at < nodes_[id].n && nodes_[id].key[at] == key)
      ++at;
    if (direction < 0 && (at == nodes_[id].n || nodes_[id].key[at] != key))
      --at;
    if (0 <= at && at < nodes_[id].n)
      return std::pair{nodes_[id].key[at], value(id, at)};
    for (int d = p.depth - 1; d >= 0; --d) {
      int parent = p.node[d], next = p.child[d] + (direction < 0 ? -1 : 1);
      if (next < 0 || next >= nodes_[parent].n)
        continue;
      id = nodes_[parent].data.child[next];
      while (!nodes_[id].leaf)
        id = nodes_[id].data.child[direction < 0 ? nodes_[id].n - 1 : 0];
      at = direction < 0 ? nodes_[id].n - 1 : 0;
      return std::pair{nodes_[id].key[at], value(id, at)};
    }
    return {};
  }
  void slot(int to, int at, int from, int source) {
    if (to == from && at == source) return;
    nodes_[to].key[at] = nodes_[from].key[source];
    if (nodes_[to].leaf)
      entry(to, at, nodes_[from].key[source], std::as_const(value(from, source)));
    else
      nodes_[to].data.child[at] = nodes_[from].data.child[source];
  }
  void remove_slot(int id, int at) {
    for (int i = at + 1; i < nodes_[id].n; ++i)
      slot(id, i - 1, id, i);
    --nodes_[id].n;
    pull(id);
  }
  void rebalance(int parent, int at) {
    int child = nodes_[parent].data.child[at];
    if (nodes_[child].n >= B / 2 || nodes_[parent].n == 1)
      return;
    int neighbor = at ? at - 1 : at + 1;
    int sib = nodes_[parent].data.child[neighbor];
    if (nodes_[sib].n > B / 2) {
      if (neighbor < at) {
        for (int i = nodes_[child].n; i > 0; --i)
          slot(child, i, child, i - 1);
        slot(child, 0, sib, nodes_[sib].n - 1);
      } else {
        slot(child, nodes_[child].n, sib, 0);
        for (int i = 1; i < nodes_[sib].n; ++i)
          slot(sib, i - 1, sib, i);
      }
      ++nodes_[child].n;
      --nodes_[sib].n;
      pull(child);
      pull(sib);
    } else {
      int left = neighbor < at ? sib : child, right = neighbor < at ? child : sib;
      for (int i = 0; i < nodes_[right].n; ++i)
        slot(left, nodes_[left].n + i, right, i);
      nodes_[left].n += nodes_[right].n;
      if (nodes_[left].leaf) {
        nodes_[left].next = nodes_[right].next;
        if (nodes_[right].next != -1) nodes_[nodes_[right].next].prev = left;
        else last_ = left;
      }
      pull(left);
      remove_slot(parent, std::max(at, neighbor));
      recycle(right);
    }
    pull(parent);
  }
  bool put(Key key, Value value, bool assign) {
    auto path = seek(key);
    if (path.leaf != -1 && path.pos < nodes_[path.leaf].n &&
        nodes_[path.leaf].key[path.pos] == key) {
      if (assign)
        this->value(path.leaf, path.pos) = std::as_const(value);
      return false;
    }
    assert(size() < std::numeric_limits<int>::max());
    std::size_t fresh = path.depth + 2;
    for (int id = free_; id != -1 && fresh; id = nodes_[id].data.child[0]) --fresh;
    const auto needed = nodes_.size() + fresh;
    if (needed > nodes_.capacity())
      nodes_.reserve(std::max(needed, nodes_.capacity() * 2));
    if (root_ == -1)
      first_ = last_ = root_ = path.leaf = allocate(true);
    int id = path.leaf;
    for (int i = nodes_[id].n; i > path.pos; --i)
      slot(id, i, id, i - 1);
    nodes_[id].key[path.pos] = key;
    entry(id, path.pos, key, std::as_const(value));
    ++nodes_[id].n;
    for (int level = path.depth;; --level) {
      pull(id);
      int right = -1;
      if (nodes_[id].n > B) {
        right = allocate(nodes_[id].leaf);
        int split = nodes_[id].n / 2;
        nodes_[right].n = nodes_[id].n - split;
        for (int i = 0; i < nodes_[right].n; ++i)
          slot(right, i, id, split + i);
        nodes_[id].n = split;
        if (nodes_[id].leaf) {
          nodes_[right].prev = id;
          nodes_[right].next = nodes_[id].next;
          if (nodes_[id].next != -1) nodes_[nodes_[id].next].prev = right;
          else last_ = right;
          nodes_[id].next = right;
        }
        pull(id);
        pull(right);
      }
      if (level == 0) {
        if (right != -1) {
          root_ = allocate(false);
          nodes_[root_].n = 2;
          nodes_[root_].data.child[0] = id;
          nodes_[root_].data.child[1] = right;
          pull(root_);
        }
        return true;
      }
      int parent = path.node[level - 1], at = path.child[level - 1];
      if (right != -1) {
        for (int i = nodes_[parent].n; i > at + 1; --i)
          slot(parent, i, parent, i - 1);
        nodes_[parent].data.child[at + 1] = right;
        ++nodes_[parent].n;
      }
      id = parent;
    }
  }
  template <class F>
  void visit(int id, F& f) const {
    const auto& node = nodes_[id];
    if (node.leaf) {
      for (int i = 0; i < node.n; ++i)
        f(node.key[i], value(id, i));
    } else
      for (int i = 0; i < node.n; ++i)
        visit(node.data.child[i], f);
  }

  template <bool Const>
  class basic_iterator {
    using Owner = std::conditional_t<Const, const OrderedMap, OrderedMap>;
    Owner* owner_ = nullptr;
    int leaf_ = -1, pos_ = 0;
    basic_iterator(Owner* owner, int leaf, int pos = 0)
        : owner_(owner), leaf_(leaf), pos_(pos) {}
    friend class OrderedMap;
    template <bool> friend class basic_iterator;

   public:
    using value_type = std::conditional_t<is_set_, Key, Entry>;
    using difference_type = std::ptrdiff_t;
    using iterator_category = std::bidirectional_iterator_tag;
    using iterator_concept = std::bidirectional_iterator_tag;
    using reference = std::conditional_t<is_set_, const Key&,
        std::conditional_t<Const, const Entry&, Entry&>>;
    using pointer = std::remove_reference_t<reference>*;
    basic_iterator() = default;
    template <bool Other> requires (Const && !Other)
    basic_iterator(const basic_iterator<Other>& other)
        : owner_(other.owner_), leaf_(other.leaf_), pos_(other.pos_) {}
    reference operator*() const {
      assert(owner_ && leaf_ != -1 && pos_ < owner_->nodes_[leaf_].n);
      if constexpr (is_set_) return owner_->nodes_[leaf_].key[pos_];
      else return owner_->nodes_[leaf_].data.value[pos_];
    }
    pointer operator->() const { return std::addressof(operator*()); }
    basic_iterator& operator++() {
      assert(owner_ && leaf_ != -1);
      if (++pos_ == owner_->nodes_[leaf_].n) {
        leaf_ = owner_->nodes_[leaf_].next;
        pos_ = 0;
      }
      return *this;
    }
    basic_iterator operator++(int) { auto old = *this; ++*this; return old; }
    basic_iterator& operator--() {
      assert(owner_);
      if (leaf_ == -1) {
        leaf_ = owner_->last_;
        assert(leaf_ != -1);
        pos_ = owner_->nodes_[leaf_].n - 1;
      } else if (pos_ != 0) --pos_;
      else {
        leaf_ = owner_->nodes_[leaf_].prev;
        assert(leaf_ != -1);
        pos_ = owner_->nodes_[leaf_].n - 1;
      }
      return *this;
    }
    basic_iterator operator--(int) { auto old = *this; --*this; return old; }
    template <bool Other>
    bool operator==(const basic_iterator<Other>& other) const {
      return owner_ == other.owner_ && leaf_ == other.leaf_ && pos_ == other.pos_;
    }
  };
 public:
  using key_type = Key;
  using mapped_type = Value;
  using value_type = std::conditional_t<is_set_, Key, Entry>;
  using iterator = basic_iterator<false>;
  using const_iterator = basic_iterator<true>;
  using reverse_iterator = std::reverse_iterator<iterator>;
  using const_reverse_iterator = std::reverse_iterator<const_iterator>;

  explicit OrderedMap(bool use_simd = true) : simd_(use_simd && simd_available()) {}
  OrderedMap(const OrderedMap&) = default;
  OrderedMap& operator=(const OrderedMap& other) {
    if (this != &other) {
      OrderedMap next(other);
      swap(next);
    }
    return *this;
  }
  OrderedMap(OrderedMap&& other) noexcept
      : nodes_(std::move(other.nodes_)),
        root_(std::exchange(other.root_, -1)),
        free_(std::exchange(other.free_, -1)),
        first_(std::exchange(other.first_, -1)),
        last_(std::exchange(other.last_, -1)),
        simd_(other.simd_) {
    other.nodes_.clear();
  }
  OrderedMap& operator=(OrderedMap&& other) noexcept {
    if (this != &other) {
      OrderedMap next(std::move(other));
      swap(next);
    }
    return *this;
  }
  void swap(OrderedMap& other) noexcept {
    nodes_.swap(other.nodes_);
    std::swap(root_, other.root_);
    std::swap(free_, other.free_);
    std::swap(first_, other.first_);
    std::swap(last_, other.last_);
    std::swap(simd_, other.simd_);
  }
  int size() const { return root_ == -1 ? 0 : nodes_[root_].total; }
  bool empty() const { return root_ == -1; }
  iterator begin() { return iterator(this, first_); }
  const_iterator begin() const { return cbegin(); }
  const_iterator cbegin() const { return const_iterator(this, first_); }
  iterator end() { return iterator(this, -1); }
  const_iterator end() const { return cend(); }
  const_iterator cend() const { return const_iterator(this, -1); }
  reverse_iterator rbegin() { return reverse_iterator(end()); }
  const_reverse_iterator rbegin() const { return crbegin(); }
  const_reverse_iterator crbegin() const { return const_reverse_iterator(cend()); }
  reverse_iterator rend() { return reverse_iterator(begin()); }
  const_reverse_iterator rend() const { return crend(); }
  const_reverse_iterator crend() const { return const_reverse_iterator(cbegin()); }
  iterator find(Key key) {
    const auto p = seek(key);
    return p.leaf != -1 && p.pos < nodes_[p.leaf].n && nodes_[p.leaf].key[p.pos] == key
        ? iterator(this, p.leaf, p.pos) : end();
  }
  const_iterator find(Key key) const {
    const auto p = seek(key);
    return p.leaf != -1 && p.pos < nodes_[p.leaf].n && nodes_[p.leaf].key[p.pos] == key
        ? const_iterator(this, p.leaf, p.pos) : cend();
  }
  bool uses_simd() const { return simd_; }
  static bool simd_available() {
#if BLUEBERRY_ORDERED_AVX && !defined(BLUEBERRY_EXTRA_FAST_FORCE_SCALAR)
    return __builtin_cpu_supports("avx2");
#else
    return false;
#endif
  }
  bool insert(Key key, Value value) { return put(key, std::as_const(value), false); }
  bool insert_or_assign(Key key, Value value) { return put(key, std::as_const(value), true); }
  Value& operator[](Key key) {
    auto p = seek(key);
    if (p.leaf == -1 || p.pos == nodes_[p.leaf].n || nodes_[p.leaf].key[p.pos] != key) {
      put(key, Value{}, false);
      p = seek(key);
    }
    return value(p.leaf, p.pos);
  }
  std::optional<Value> get(Key key) const {
    auto p = seek(key);
    if (p.leaf == -1 || p.pos == nodes_[p.leaf].n || nodes_[p.leaf].key[p.pos] != key)
      return {};
    return value(p.leaf, p.pos);
  }
  bool contains(Key key) const { return get(key).has_value(); }
  int rank(Key key) const {
    auto p = seek<true>(key);
    return p.rank + p.pos;
  }
  std::optional<std::pair<Key, Value>> kth(int k) const {
    if (k < 0 || k >= size())
      return {};
    int id = root_;
    while (!nodes_[id].leaf) {
      int at = 0;
      while (k >= nodes_[nodes_[id].data.child[at]].total) {
        k -= nodes_[nodes_[id].data.child[at]].total;
        ++at;
      }
      id = nodes_[id].data.child[at];
    }
    return std::pair{nodes_[id].key[k], value(id, k)};
  }
  std::optional<std::pair<Key, Value>> lower_bound(Key key) const { return bound(key, 0); }
  std::optional<std::pair<Key, Value>> upper_bound(Key key) const { return bound(key, 1); }
  std::optional<std::pair<Key, Value>> floor(Key key) const { return bound(key, -1); }
  bool erase(Key key) {
    auto p = seek(key);
    if (p.leaf == -1 || p.pos == nodes_[p.leaf].n || nodes_[p.leaf].key[p.pos] != key)
      return false;
    int id = p.leaf;
    remove_slot(id, p.pos);
    for (int d = p.depth - 1; d >= 0; --d) {
      int parent = p.node[d];
      rebalance(parent, p.child[d]);
      pull(parent);
      id = parent;
    }
    if (nodes_[root_].n == 0) {
      int old = root_;
      root_ = -1;
      first_ = last_ = -1;
      recycle(old);
    } else if (!nodes_[root_].leaf && nodes_[root_].n == 1) {
      int old = root_;
      root_ = nodes_[old].data.child[0];
      recycle(old);
    }
    return true;
  }
  iterator erase(const_iterator pos) {
    assert(pos.owner_ == this && pos.leaf_ != -1);
    const Key key = nodes_[pos.leaf_].key[pos.pos_];
    const auto next = ++pos;
    const auto next_key = next == cend() ? std::optional<Key>{}
        : std::optional<Key>{nodes_[next.leaf_].key[next.pos_]};
    erase(key);
    return next_key ? find(*next_key) : end();
  }
  void clear() {
    nodes_.clear();
    root_ = free_ = first_ = last_ = -1;
  }
  template <class F>
  void for_each(F&& f) const {
    if (root_ != -1)
      visit(root_, f);
  }
};
template <class Key = std::uint32_t>
class OrderedSet {
  using Tree = OrderedMap<Key, internal::OrderedSetMarker>;
  Tree tree_;
  static std::optional<Key> key_of(std::optional<std::pair<Key, internal::OrderedSetMarker>> entry) {
    if (entry)
      return entry->first;
    return {};
  }

 public:
  using key_type = Key;
  using value_type = Key;
  using iterator = typename Tree::const_iterator;
  using const_iterator = iterator;
  using reverse_iterator = std::reverse_iterator<iterator>;
  using const_reverse_iterator = reverse_iterator;
  explicit OrderedSet(bool use_simd = true) : tree_(use_simd) {}
  int size() const { return tree_.size(); }
  bool empty() const { return tree_.empty(); }
  bool uses_simd() const { return tree_.uses_simd(); }
  static bool simd_available() { return Tree::simd_available(); }
  iterator begin() { return tree_.cbegin(); }
  const_iterator begin() const { return cbegin(); }
  const_iterator cbegin() const { return tree_.cbegin(); }
  iterator end() { return tree_.cend(); }
  const_iterator end() const { return cend(); }
  const_iterator cend() const { return tree_.cend(); }
  reverse_iterator rbegin() { return reverse_iterator(end()); }
  const_reverse_iterator rbegin() const { return crbegin(); }
  const_reverse_iterator crbegin() const { return const_reverse_iterator(cend()); }
  reverse_iterator rend() { return reverse_iterator(begin()); }
  const_reverse_iterator rend() const { return crend(); }
  const_reverse_iterator crend() const { return const_reverse_iterator(cbegin()); }
  iterator find(Key key) { return std::as_const(tree_).find(key); }
  const_iterator find(Key key) const { return tree_.find(key); }
  bool insert(Key key) { return tree_.insert(key, {}); }
  bool erase(Key key) { return tree_.erase(key); }
  iterator erase(const_iterator pos) { return tree_.erase(pos); }
  bool contains(Key key) const { return tree_.contains(key); }
  int rank(Key key) const { return tree_.rank(key); }
  std::optional<Key> kth(int k) const { return key_of(tree_.kth(k)); }
  std::optional<Key> lower_bound(Key key) const { return key_of(tree_.lower_bound(key)); }
  std::optional<Key> upper_bound(Key key) const { return key_of(tree_.upper_bound(key)); }
  std::optional<Key> floor(Key key) const { return key_of(tree_.floor(key)); }
  void clear() { tree_.clear(); }
  template <class F>
  void for_each(F&& f) const {
    tree_.for_each([&](const Key& key, internal::OrderedSetMarker) { f(key); });
  }
};
}  // namespace blueberry::extra_fast
#undef BLUEBERRY_ORDERED_AVX
