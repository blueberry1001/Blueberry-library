/docs/development/measurements/template-fast-io/**/*.jsonl text eol=lf
/docs/development/measurements/template-fast-io/**/*.sh text eol=lf

# Keep the follow-up SIMD experiments reproducible across Windows/Linux.
/docs/development/measurements/extra-fast-expansion/**/*.log -text -whitespace
/docs/development/measurements/extra-fast-expansion/**/*.txt -text -whitespace
