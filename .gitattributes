# Preserve the user's original template byte-for-byte, including its missing EOF newline.
/.verify-helper/docs/static/assets/code/blueberrytemplate.h -text -whitespace

# Keep benchmark diagnostics byte-for-byte, including original whitespace.
/benchmark/lc-expansion-fps-sequences/**/*.log -text -whitespace
/benchmark/lc-expansion-tetration*.log -text -whitespace
/benchmarks/research/lc-expansion-primitive-root/*.log -text -whitespace
/docs/development/measurements/sparse-exp/**/*.log -text -whitespace
/docs/development/measurements/sparse-exp/**/*.txt -text -whitespace

# Keep measured inputs, snapshots and diagnostics stable across Windows/Linux.
/docs/development/measurements/extra-fast/**/*.log -text -whitespace
/docs/development/measurements/extra-fast/**/*.snapshot -text -whitespace
/docs/development/measurements/extra-fast/**/*.json text eol=lf
/docs/development/measurements/extra-fast/**/*.jsonl text eol=lf
/docs/development/measurements/extra-fast/**/*.s -text

